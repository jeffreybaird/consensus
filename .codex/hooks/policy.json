{
  "legacy_commands": [
    "./scripts/protect-tests.sh",
    "./scripts/gate.sh"
  ],
  "schema_version": 2,
  "source_globs": [
    "app/*.rb",
    "lib/*.rb",
    "views/*.erb",
    "views/*.haml",
    "views/*.slim",
    "config/*.rb",
    "db/migrate/*.rb",
    "db/seed-data/*.rb",
    "public/js/*.js",
    "public/js/*.mjs",
    "public/js/*.ts",
    "public/css/*.css",
    "public/css/*.scss",
    "scripts/*.sh",
    "scripts/*.rb",
    "app.rb",
    "config.ru",
    "Gemfile",
    "Gemfile.lock",
    "Rakefile",
    ".rubocop.yml",
    "infra/*.tf",
    "infra/*.hcl",
    "infra/*.yaml",
    "infra/*.yml",
    "deploy/*.sh",
    "deploy/*.yaml",
    "deploy/*.yml",
    "deploy/*.tmpl",
    "deploy/Caddyfile",
    "Dockerfile",
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    "bin/vendor-biometry",
    "vendor/biometry/lib/*.rb",
    "vendor/biometry/biometry.gemspec",
    "vendor/biometry/exe/biometry"
  ],
  "test_globs": [
    "spec/**",
    "**/*_test.py",
    "**/*.test.js",
    "**/*.test.ts",
    "**/*.spec.js",
    "**/*.spec.ts"
  ]
}
