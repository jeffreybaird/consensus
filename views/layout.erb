<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Consensus</title>
    <script>
      // Stamp the saved theme before first paint so a light-theme reader
      // never gets a dark flash. Behavior lives in /js/theme.js.
      try { var t = localStorage.getItem("theme");
            if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) {}
    </script>
    <link rel="stylesheet" href="/css/app.css">
    <script src="/js/theme.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">Consensus</a>
      <nav>
        <a href="/standards">Standards</a>
        <button type="button" data-theme-toggle aria-label="Light theme" aria-pressed="false">◐</button>
      </nav>
    </header>
    <main>
      <%== yield %>
    </main>
  </body>
</html>
